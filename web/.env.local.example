# Copy to .env.local and fill in from your Supabase project settings (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY — never prefix with NEXT_PUBLIC_. Used only in Next.js API routes for admin
# mutations that must bypass RLS. Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
