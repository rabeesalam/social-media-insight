# Copy to local.properties (gitignored). sdk.dir is written automatically by Android
# Studio/Gradle on first sync if missing — set it explicitly here if that doesn't happen.
sdk.dir=C\:\\Users\\rabees.alam\\dev-tools\\android-sdk

# Supabase — safe to embed in the APK: the anon key alone grants nothing without RLS/device-secret
# checks passing (see docs/decisions/0002-secret-boundary-and-auth-model.md). No service-role key
# ever belongs here.
SUPABASE_URL=https://ypnftmiulzrrwpbgdgwy.supabase.co
SUPABASE_ANON_KEY=

# Per-platform OAuth client IDs ONLY — never a client_secret (those live exclusively in the
# oauth-exchange Supabase Edge Function's secrets, see supabase/functions/oauth-exchange/).
# Leave blank until you've created the developer app for that platform; the Connect Accounts
# screen shows "Not configured" for any platform whose client ID is blank, rather than crashing
# or pretending it works.
INSTAGRAM_CLIENT_ID=
TIKTOK_CLIENT_KEY=
YOUTUBE_CLIENT_ID=
FACEBOOK_CLIENT_ID=
THREADS_CLIENT_ID=
X_CLIENT_ID=
