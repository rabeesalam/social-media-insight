<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Social Analytics"
        android:theme="@style/Theme.SocialInsight"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SocialInsight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth redirect deep link (Instagram/TikTok/Facebook/Threads/X), e.g.
                 com.puresquare.socialinsight://oauth-callback?code=...&state=...
                 Must be registered as the exact redirect_uri in each platform's developer console. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${oauthRedirectScheme}"
                    android:host="${oauthRedirectHost}" />
            </intent-filter>

            <!-- Shared HTTPS App Link redirect for platforms whose Android OAuth rules don't allow
                 a custom scheme — Google (ADR-0008) and TikTok both require this. autoVerify="true"
                 makes Android check web/public/.well-known/assetlinks.json at install time and
                 route matching navigations straight to this activity instead of the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${appLinkRedirectHost}"
                    android:pathPrefix="/oauth-callback" />
            </intent-filter>
        </activity>

    </application>
</manifest>
